# Salesforce CLI org alias or username from `sf org login web`.
# Leave unset to use the CLI default target org.
SF_TARGET_ORG=

# SQL LIKE filter applied by the list_tables tool (optional)
# Default '%' lists everything. Use a prefix like 'ssot__%' to scope to standard DMOs.
# Only letters, numbers, underscores, and % are accepted.
DEFAULT_LIST_TABLE_FILTER=%

# Caps for the query tool.
MAX_QUERY_ROWS=1000
MAX_QUERY_BYTES=1000000

# Private local usage logs. Arguments are hashed before they are written.
# MCP_USAGE_LOG_DIR=~/.data360-mcp/usage_logs

# Per-tool call limits inside one window.
MCP_RATE_WINDOW_SECONDS=60
MCP_DESTRUCTIVE_RATE_LIMIT=10
MCP_WRITE_RATE_LIMIT=20
MCP_READ_RATE_LIMIT=120

# Refuse to start when tool descriptions or schemas differ from tool_definitions.sha256.
MCP_ENFORCE_TOOL_PINS=true
