# Salesforce Connected App credentials (required)
# See CONNECTED_APP_SETUP.md for how to create these in your org.
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Salesforce login host (optional)
# Use 'login.salesforce.com' for production / developer orgs (default).
# Use 'test.salesforce.com' for sandboxes.
# Or your My Domain, e.g. 'mycompany.my.salesforce.com'.
SF_LOGIN_URL=login.salesforce.com

# OAuth callback URL (optional, must match the Connected App's Callback URL)
# Default port is 55556. DO NOT use 55555.
SF_CALLBACK_URL=http://localhost:55556/Callback

# SQL LIKE filter applied by the list_tables tool (optional)
# Default '%' lists everything. Use a prefix like 'ssot__%' to scope to standard DMOs.
DEFAULT_LIST_TABLE_FILTER=%
